# Copy to .env and fill in. See DESIGN.md §3.
# Dashboard: Project Settings -> API (URL, service_role key) and
#            Project Settings -> API -> JWT Settings (JWT secret).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Only used by backend/db/apply.sh (psql) to apply migrations + seed.
# Dashboard: Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

SANDBOX_IMAGE=parscript-sandbox
SANDBOX_TIMEOUT_SECONDS=10

# Comma-separated; Vite dev server default is 5173
CORS_ORIGINS=http://localhost:5173
